# Copy this to .env.production on the VPS (never commit the real one — it's
# gitignored already via the root .env / .env.* rule) and fill in real values.
#
# Generate the two secrets with:
#   openssl rand -hex 64

# Your two domains, pointed at the VPS's IP via A records (see DEPLOYMENT.md).
DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com

# Postgres credentials — pick your own, they're created fresh on first boot.
DB_USERNAME=foodmap
DB_PASSWORD=

# Signs dashboard access tokens (Auth::JsonWebToken).
JWT_SECRET_KEY=

# Rails' secret_key_base — used to encrypt the auth/refresh cookies.
# Setting this env var is a deliberate alternative to shipping config/master.key
# to the server: Rails prefers SECRET_KEY_BASE over credentials when it's set,
# so production never needs the master key at all.
SECRET_KEY_BASE=
